
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kakkad Food</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial;background:#fff8f0;color:#292929}
header{background:#e85d04;color:white;padding:25px 18px;border-radius:0 0 22px 22px}
header h1{margin:0;font-size:30px}
header p{margin-bottom:0}
.container{padding:18px}
h2{color:#d9480f}
.products{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.item{background:white;border-radius:14px;padding:12px;box-shadow:0 2px 8px #ddd}
.item .food{font-size:55px;text-align:center}
.item h3{margin:8px 0}
.price{color:#e85d04;font-weight:bold}
button{background:#e85d04;color:white;border:0;padding:11px;border-radius:8px;width:100%;font-weight:bold}
.cart{background:white;padding:16px;border-radius:14px;margin-top:20px}
</style>
</head>
<body>

<header>
<h1>🍔 Kakkad Food</h1>
<p>Welcome! Fresh Food, Fast Delivery</p>
</header>

<div class="container">
<h2>Our Menu</h2>
<div class="products">

<div class="item">
<div class="food">🍕</div>
<h3>Pizza</h3>
<p class="price">₹199</p>
<button onclick="add('Pizza',199)">Add to Cart</button>
</div>

<div class="item">
<div class="food">🍔</div>
<h3>Burger</h3>
<p class="price">₹99</p>
<button onclick="add('Burger',99)">Add to Cart</button>
</div>

<div class="item">
<div class="food">🎂</div>
<h3>Cake</h3>
<p class="price">₹499</p>
<button onclick="add('Cake',499)">Add to Cart</button>
</div>

<div class="item">
<div class="food">🍰</div>
<h3>Pastry</h3>
<p class="price">₹60</p>
<button onclick="add('Pastry',60)">Add to Cart</button>
</div>

</div>

<div class="cart">
<h2>🛒 My Cart</h2>
<div id="cart">No items added</div>
<h3 id="total">Total: ₹0</h3>
<button onclick="alert('Checkout setup will be added next!')">Continue to Checkout</button>
</div>
</div>

<script>
let items=[];
function add(name,price){
items.push({name,price});
document.getElementById('cart').innerHTML=
items.map(x=>x.name+' - ₹'+x.price).join('<br>');
let total=items.reduce((s,x)=>s+x.price,0);
document.getElementById('total').innerText='Total: ₹'+total;
}
</script>

</body>
</html>
